{
  "name": "encore",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "playtest": "esbuild tools/playtest/run.ts --bundle --platform=node --format=esm --log-level=warning --outfile=tools/playtest/out/run.mjs && node tools/playtest/out/run.mjs",
    "playtest:boss": "esbuild tools/playtest/boss.ts --bundle --platform=node --format=esm --log-level=warning --outfile=tools/playtest/out/boss.mjs && node tools/playtest/out/boss.mjs",
    "playtest:bench": "esbuild tools/playtest/bench.ts --bundle --platform=node --format=esm --log-level=warning --outfile=tools/playtest/out/bench.mjs && node tools/playtest/out/bench.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
